# The eval set: question -> expected QuerySpec. One JSON object per line.
#
# It compares specs, not prose, so it runs with no ANTHROPIC_API_KEY and costs nothing
# (docs/build-spec.md section 3, GA-05). `npm run eval` scores it against the fallback
# parser; `npm run eval -- --live` will score the same lines against the model in GA-08.
#
# `guards: "default"` expands to every guard the layer declares, with the layer's
# thresholds. An omitted `sort.tieBreak` expands to the layer's `defaultTieBreak` — the
# model never chooses one, and neither may the fallback parser.
#
# Each case's `note` records what it is for. Where a case earned a synonym, the note says
# so: under the thinnest-viable layer, structure is added because a failing eval demanded
# it (docs/build-spec.md section 8, item 3).

# --- Starter questions: the catalogue the fallback parser maps, and the zero state's copy.
{"id":"s-top-rated-titles","kind":"starter","question":"What are our top rated titles?","expect":{"spec":{"measure":"avg_rating","breakdown":"title","sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default"}},"note":"The hero moment (design section 4): 296 titles tied at 5.00 naively against A Streetcar Named Desire at 4.47 (n=20) honestly."}
{"id":"s-most-rated-titles","kind":"starter","question":"Which titles have the most ratings?","expect":{"spec":{"measure":"rating_count","breakdown":"title","sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default"}},"note":"A count measure over the same breakdown as the hero, so a measure swap is exercised on its own."}
{"id":"s-rating-by-genre","kind":"starter","question":"How does average rating compare across genres?","expect":{"spec":{"measure":"avg_rating","breakdown":"genre","sort":{"by":"measure","dir":"desc"},"limit":19,"guards":"default"}},"note":"Limit 19 is the measured genre cardinality that grounds MAX_LIMIT (contracts/query-spec.ts); a question about every genre shows every genre."}
{"id":"s-ratings-by-genre","kind":"starter","question":"How many ratings does each genre have?","expect":{"spec":{"measure":"rating_count","breakdown":"genre","sort":{"by":"measure","dir":"desc"},"limit":19,"guards":"default"}},"note":"Shares a breakdown with s-rating-by-genre, so the measure alone has to separate them."}
{"id":"s-titles-by-genre","kind":"starter","question":"How many titles are in each genre?","expect":{"spec":{"measure":"title_count","breakdown":"genre","sort":{"by":"measure","dir":"desc"},"limit":19,"guards":"default"}},"note":"A title-grain measure: observations count titles, not ratings."}
{"id":"s-viewers-by-genre","kind":"starter","question":"How many viewers rated each genre?","expect":{"spec":{"measure":"viewer_count","breakdown":"genre","sort":{"by":"measure","dir":"desc"},"limit":19,"guards":"default"}},"note":"The fifth declared measure, so every measure in the layer is reachable from the zero state."}
{"id":"s-share-4-plus-by-genre","kind":"starter","question":"Which genres have the highest share rated 4 or higher?","expect":{"spec":{"measure":"share_rated_4_plus","breakdown":"genre","sort":{"by":"measure","dir":"desc"},"limit":19,"guards":"default"}},"note":"A label carrying a numeral, which normalisation must keep whole: 4 is part of the phrase."}
{"id":"s-ratings-by-year","kind":"starter","question":"How many ratings did we get each year?","expect":{"spec":{"measure":"rating_count","breakdown":"rating_year","sort":{"by":"breakdown","dir":"asc"},"limit":23,"guards":"default"}},"note":"Ordered by the breakdown, not the measure: a question about a sequence gets a chronological axis. Pins that the catalogue can express both."}
{"id":"s-rating-by-decade","kind":"starter","question":"How does average rating compare across release decades?","expect":{"spec":{"measure":"avg_rating","breakdown":"release_decade","sort":{"by":"breakdown","dir":"asc"},"limit":12,"guards":"default"}},"note":"The third avg_rating starter, so the breakdown alone has to separate it from the other two."}

# --- Paraphrases: the same questions in other words. Each one that passes does so because
# --- the layer declares a phrase it can reach, never because the parser guessed.
{"id":"p-best-rated-movies","kind":"paraphrase","question":"What are our best rated movies?","expect":{"spec":{"measure":"avg_rating","breakdown":"title","sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default"}},"note":"Earned avg_rating synonym \"best rated\" and title synonym \"movies\". Failed before both landed."}
{"id":"p-highest-average-rating","kind":"paraphrase","question":"Which movies have the highest average rating?","expect":{"spec":{"measure":"avg_rating","breakdown":"title","sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default"}},"note":"Earned nothing of its own: it passes on the label \"average rating\" plus the \"movies\" synonym p-best-rated-movies already earned."}
{"id":"p-most-ratings-per-genre","kind":"paraphrase","question":"Which genres have the most ratings?","expect":{"spec":{"measure":"rating_count","breakdown":"genre","sort":{"by":"measure","dir":"desc"},"limit":19,"guards":"default"}},"note":"Earned rating_count synonym \"ratings\" and genre synonym \"genres\". \"ratings\" must not also reach avg_rating, whose vocabulary is \"average rating\" and \"best rated\"."}
{"id":"p-average-rating-each-genre","kind":"paraphrase","question":"What is the average rating in each genre?","expect":{"spec":{"measure":"avg_rating","breakdown":"genre","sort":{"by":"measure","dir":"desc"},"limit":19,"guards":"default"}},"note":"Earned nothing: it passes on declared labels alone, which is what the layer looked like before any synonym was added."}
{"id":"p-most-viewers-per-genre","kind":"paraphrase","question":"Which genres get the most viewers?","expect":{"spec":{"measure":"viewer_count","breakdown":"genre","sort":{"by":"measure","dir":"desc"},"limit":19,"guards":"default"}},"note":"Earned viewer_count synonym \"viewers\"."}
{"id":"p-how-well-reviewed","kind":"paraphrase","question":"How well reviewed are our movies?","expect":{"spec":{"measure":"avg_rating","breakdown":"title","sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default"}},"note":"KNOWN FAILING, deliberately. \"how well reviewed\" is a judgement about a measure, not a name for one, and declaring it a synonym of avg_rating is a product decision rather than a reflex. It is the backlog the committed baseline leaves room for."}

# --- Rejections: invariant 4, scored. An undeclared question becomes a clarifying question
# --- naming the gap and offering questions that work, never a coerced nearest match.
{"id":"r-revenue-by-genre","kind":"rejection","question":"How much revenue did each genre make?","expect":{"rejection":{"term":"revenue","termKind":"measure"}},"note":"A measure no MovieLens delivery carries. The breakdown is declared, so only the measure is missing."}
{"id":"r-director","kind":"rejection","question":"Who directed our top rated movies?","expect":{"rejection":{"term":"director","termKind":"dimension"}},"note":"The dimension is undeclared. Guards against a future synonym making \"top rated movies\" match while \"directed\" is silently dropped."}
{"id":"r-fewest-ratings","kind":"rejection","question":"Which genres have the fewest ratings?","expect":{"rejection":{"term":"fewest","termKind":"measure"}},"note":"Every word here is declared vocabulary, and the catalogue declares no ascending ranking. Answering with the descending one would be the silent coercion invariant 4 exists to remove."}

# --- Amendments: a follow-up patches the previous spec. The keyless path scores the patch
# --- the harness applies; GA-09 scores the patch the model produces from the same follow-up.
{"id":"a-filter-to-drama","kind":"amendment","followUp":"just drama","parent":{"measure":"avg_rating","breakdown":"title","sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default"},"parentResolvedAsOf":"2018-09-26T00:00:00.000Z","patch":{"basedOn":"eval-parent","addFilters":[{"dimension":"genre","op":"eq","value":"Drama"}]},"expect":{"spec":{"measure":"avg_rating","breakdown":"title","filters":[{"dimension":"genre","op":"eq","value":"Drama"}],"sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default","asOf":"2018-09-26T00:00:00.000Z"}},"note":"An absent reAsOf inherits the parent's resolvedAsOf, so the follow-up interrogates the same snapshot and the two answers are comparable."}
{"id":"a-bring-up-to-date","kind":"amendment","followUp":"bring that up to date","parent":{"measure":"avg_rating","breakdown":"title","sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default"},"parentResolvedAsOf":"2018-09-26T00:00:00.000Z","patch":{"basedOn":"eval-parent","reAsOf":null},"expect":{"spec":{"measure":"avg_rating","breakdown":"title","sort":{"by":"measure","dir":"desc"},"limit":10,"guards":"default","asOf":null}},"note":"reAsOf: null re-resolves to latest. Absent and null are different facts, and this pair is what keeps `\"reAsOf\" in patch` a real discriminator through parsing."}
